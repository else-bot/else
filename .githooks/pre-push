#!/bin/sh
set -eu
for variable in $(git rev-parse --local-env-vars); do
	unset "$variable"
done
# Nextest runs tests from every binary in parallel; cargo test runs binaries one by one.
if command -v cargo-nextest >/dev/null 2>&1; then
	cargo nextest run --workspace --locked
	exec cargo test --workspace --locked --doc
fi
exec cargo test --workspace --locked
