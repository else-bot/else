#!/bin/sh
set -eu
# Read every pushed ref first: git writes them to stdin and fails the push on a closed pipe.
refs=$(cat)
for variable in $(git rev-parse --local-env-vars); do
	unset "$variable"
done

# Rust does not compile these paths in, so pushes that only touch them skip the tests.
needs_tests=false
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ -n "${local_sha:-}" ] || continue
	case "$local_sha" in "$zero") continue ;; esac
	case "$remote_sha" in
	"$zero") base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || { needs_tests=true; break; } ;;
	*) base=$remote_sha ;;
	esac
	if ! paths=$(git diff --name-only --no-renames "$base" "$local_sha" 2>/dev/null); then
		needs_tests=true
		break
	fi
	if printf '%s\n' "$paths" | grep -qvE '^(docs/|\.agents/|\.claude/|\.github/|[^/]+\.md$|$)'; then
		needs_tests=true
		break
	fi
done <<EOF
$refs
EOF
if [ "$needs_tests" = false ]; then
	exit 0
fi

# Nextest runs tests from every binary in parallel; cargo test runs binaries one by one.
if command -v cargo-nextest >/dev/null 2>&1; then
	cargo nextest run --workspace --locked
	exec cargo test --workspace --locked --doc
fi
exec cargo test --workspace --locked
