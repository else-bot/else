# Direct API configuration. scripts/dev.py supplies its own settings.
# ELSE_API_BIND=127.0.0.1:7879   (development default; installations use 7878)
# DATABASE_URL=sqlite:///absolute/path/else.sqlite3 (default: <ELSE_DATA_DIR>/else.sqlite3)
# ELSE_DATA_DIR=/absolute/path/for/this/checkout
# ELSE_BOTS_DIR=/absolute/path   (default: <ELSE_DATA_DIR>/projects)

# Official API builds embed GitHub MCP OAuth registration. Set both variables
# only to override it with your own dedicated OAuth App on github.com.
# Callback URL: http://127.0.0.1/mcp/callback
# ELSE_GITHUB_CLIENT_ID=
# ELSE_GITHUB_CLIENT_SECRET=
