COMPOSE_PROJECT_NAME=else-dev
COMPOSE_FILE=infra/compose.yaml

POSTGRES_DB=else
POSTGRES_USER=else
POSTGRES_PASSWORD=else_dev_only
POSTGRES_PORT=5432

# API settings. See docs/development.md for every variable and its default.
# ELSE_API_BIND=127.0.0.1:7879   (development default; installations use 7878)
# ELSE_DATA_DIR=/absolute/path/for/this/checkout

# S3 emulator (SeaweedFS in Compose) for the replication tests. Synthetic
# credentials for the local container only.
ELSE_TEST_S3_ENDPOINT=http://127.0.0.1:8333
ELSE_TEST_S3_REGION=us-east-1
ELSE_TEST_S3_PORT=8333
ELSE_TEST_S3_ACCESS_KEY_ID=elsetestaccess01
ELSE_TEST_S3_SECRET_ACCESS_KEY=elsetestsecret0123456789abcdef
