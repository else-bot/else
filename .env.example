# API settings. See docs/development.md for every variable and its default.
# ELSE_API_BIND=127.0.0.1:7879   (development default; installations use 7878)
# DATABASE_URL=sqlite:///absolute/path/else.sqlite3 (default: <ELSE_DATA_DIR>/else.sqlite3)
# ELSE_DATA_DIR=/absolute/path/for/this/checkout
# ELSE_BOTS_DIR=/absolute/path   (bots' project directories; development default ~/.else-dev/bots)

# The replication tests take no settings from here: scripts/test-replication.py
# starts a private S3 emulator per run, with its own Compose project, port and
# synthetic credentials, and removes it afterwards.
