+
+/*
+ * hook called with the UTF-8 text of an ExtendedClipboard client; it ends
+ * in a NUL, which is not part of the text.
+ */
+void xcut_receive_utf8(char *text, int len, rfbClientPtr cl) {
+	while (len > 0 && text[len - 1] == '\0') {
+		len--;
+	}
+	xcut_store(text, len, cl, 1);
+}
