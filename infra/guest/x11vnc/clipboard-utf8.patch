 /*
+ * Latin-1 for UTF-8 text; characters outside Latin-1 and malformed bytes
+ * become '?'. The result is NUL-terminated and must be freed.
+ */
+char *utf8_to_latin1(const char *str, unsigned int len, unsigned int *out_len) {
+	const unsigned char *s = (const unsigned char *) str;
+	char *out = (char *) malloc((size_t) len + 1);
+	unsigned int i = 0, n = 0;
+	while (i < len) {
+		unsigned char c = s[i];
+		unsigned int need, cp, k;
+		if (c < 0x80) {
+			out[n++] = (char) c;
+			i++;
+			continue;
+		}
+		if ((c & 0xE0) == 0xC0) {
+			need = 1;
+			cp = c & 0x1F;
+		} else if ((c & 0xF0) == 0xE0) {
+			need = 2;
+			cp = c & 0x0F;
+		} else if ((c & 0xF8) == 0xF0) {
+			need = 3;
+			cp = c & 0x07;
+		} else {
+			out[n++] = '?';
+			i++;
+			continue;
+		}
+		for (k = 1; k <= need; k++) {
+			if (i + k >= len || (s[i + k] & 0xC0) != 0x80) {
+				break;
+			}
+			cp = (cp << 6) | (s[i + k] & 0x3F);
+		}
+		if (k <= need) {
+			out[n++] = '?';
+			i += k;
+			continue;
+		}
+		out[n++] = cp <= 0xFF ? (char) cp : '?';
+		i += need + 1;
+	}
+	out[n] = '\0';
+	*out_len = n;
+	return out;
+}
+
+static char *latin1_to_utf8(const char *str, unsigned int len, unsigned int *out_len) {
+	const unsigned char *s = (const unsigned char *) str;
+	char *out = (char *) malloc((size_t) len * 2 + 1);
+	unsigned int i, n = 0;
+	for (i = 0; i < len; i++) {
+		if (s[i] < 0x80) {
+			out[n++] = (char) s[i];
+		} else {
+			out[n++] = (char) (0xC0 | (s[i] >> 6));
+			out[n++] = (char) (0x80 | (s[i] & 0x3F));
+		}
+	}
+	out[n] = '\0';
+	*out_len = n;
+	return out;
+}
