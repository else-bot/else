#!/bin/sh
# Start the desktop (screen, VNC, and Chromium) when it is not running and
# wait for the browser; idempotent. Root starts the supervisor if needed; the
# desktop user can start the programs through the supervisor's socket.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
conf=/etc/elsebot/supervisord.conf
if [ "$(id -u)" = 0 ]; then
    /usr/local/bin/else-init >/dev/null || exit 1
fi
supervisorctl -c "$conf" start xvfb openbox x11vnc x11vnc-watch novnc chromium >/dev/null 2>&1
i=0
while [ "$i" -lt 100 ]; do
    if curl -s -m 1 -o /dev/null http://127.0.0.1:9222/json/version; then
        echo started
        exit 0
    fi
    i=$((i + 1))
    sleep 0.2
done
echo "the desktop did not start: $(supervisorctl -c "$conf" status 2>&1 | tr '\n' ';')" >&2
exit 1
