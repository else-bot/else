#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin
set -e
mkdir -p /run/elsebot /var/log/elsebot
# $1 is the owner's IANA time zone. Sites such as X block logins from a
# browser whose clock zone does not match the person using it; Chromium
# reads it when it starts.
case "$1" in
    ''|*..*|/*|*[!A-Za-z0-9/_+-]*) ;;
    *) if [ -f "/usr/share/zoneinfo/$1" ]; then
           ln -sf "/usr/share/zoneinfo/$1" /etc/localtime
           echo "$1" > /etc/timezone
       fi ;;
esac
pid="$(cat /run/elsebot/supervisord.pid 2>/dev/null || true)"
if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = supervisord ]; then
    echo already-running
    exit 0
fi
rm -f /run/elsebot/supervisord.pid /run/elsebot/supervisor.sock /tmp/.X99-lock /tmp/.X11-unix/X99
# Chromium is not running yet. Its profile lock names the host it last ran
# on; a computer whose data came from another one (an image upgrade or a
# restore under another name) has a different hostname, and Chromium would
# refuse the profile as in use elsewhere. The lock is stale here.
rm -f /home/elsebot/.config/chromium/SingletonLock /home/elsebot/.config/chromium/SingletonCookie \
      /home/elsebot/.config/chromium/SingletonSocket
if [ -f /etc/elsebot/vnc.pass ]; then
    chown elsebot:elsebot /etc/elsebot/vnc.pass
    chmod 0600 /etc/elsebot/vnc.pass
fi
/usr/bin/supervisord -c /etc/elsebot/supervisord.conf
echo started
