#!/usr/bin/env python3
"""Capture the whole desktop (X display :99, the one VNC serves) as a PNG.

Usage: else-screenshot OUT.png [MAX_BYTES]
Prints one JSON object: the screen size, the image size and scale (screen
pixels per image pixel), the pointer position in screen pixels, the PNG's
size and SHA-256, and the capture time. When the PNG would exceed MAX_BYTES
(default 1,500,000) the image is reduced by 2, then 3, then 4; beyond that it
fails with IMAGE_TOO_LARGE. Uses libX11 through ctypes and zlib: no packages.
Runs inside the guest as the desktop user; nothing leaves the VM but the file.
"""
import ctypes
import ctypes.util
import hashlib
import json
import os
import struct
import sys
import time
import zlib


class XImage(ctypes.Structure):
    _fields_ = [
        ("width", ctypes.c_int), ("height", ctypes.c_int), ("xoffset", ctypes.c_int),
        ("format", ctypes.c_int), ("data", ctypes.POINTER(ctypes.c_ubyte)),
        ("byte_order", ctypes.c_int), ("bitmap_unit", ctypes.c_int),
        ("bitmap_bit_order", ctypes.c_int), ("bitmap_pad", ctypes.c_int),
        ("depth", ctypes.c_int), ("bytes_per_line", ctypes.c_int),
        ("bits_per_pixel", ctypes.c_int), ("red_mask", ctypes.c_ulong),
        ("green_mask", ctypes.c_ulong), ("blue_mask", ctypes.c_ulong),
    ]


def fail(code, message, status=3):
    print(json.dumps({"error": f"{code}: {message}"}))
    sys.exit(status)


def png(width, height, rows):
    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)
    raw = b"".join(b"\x00" + r for r in rows)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def main(argv):
    if not argv:
        fail("USAGE", __doc__.strip(), 2)
    out = argv[0]
    max_bytes = int(argv[1]) if len(argv) > 1 else 1_500_000
    lib = ctypes.util.find_library("X11") or "libX11.so.6"
    try:
        x = ctypes.cdll.LoadLibrary(lib)
    except OSError as e:
        fail("DISPLAY_UNAVAILABLE", f"libX11 is not installed ({e})")
    x.XOpenDisplay.restype = ctypes.c_void_p
    x.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x.XDefaultRootWindow.restype = ctypes.c_ulong
    x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    x.XDefaultScreen.argtypes = [ctypes.c_void_p]
    x.XDisplayWidth.argtypes = [ctypes.c_void_p, ctypes.c_int]
    x.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
    x.XGetImage.restype = ctypes.POINTER(XImage)
    x.XGetImage.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int,
                            ctypes.c_uint, ctypes.c_uint, ctypes.c_ulong, ctypes.c_int]
    x.XDestroyImage.argtypes = [ctypes.POINTER(XImage)]
    x.XQueryPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong] + [ctypes.c_void_p] * 2 + [ctypes.c_void_p] * 4 + [ctypes.c_void_p]
    x.XCloseDisplay.argtypes = [ctypes.c_void_p]
    display = x.XOpenDisplay(os.environ.get("DISPLAY", ":99").encode())
    if not display:
        fail("DISPLAY_UNAVAILABLE", "the desktop display is not running")
    root = x.XDefaultRootWindow(display)
    screen = x.XDefaultScreen(display)
    width, height = x.XDisplayWidth(display, screen), x.XDisplayHeight(display, screen)
    image = x.XGetImage(display, root, 0, 0, width, height, 0xFFFFFFFF, 2)  # AllPlanes, ZPixmap
    if not image:
        fail("DISPLAY_UNAVAILABLE", "the display could not be read")
    img = image.contents
    if img.bits_per_pixel != 32 or img.red_mask != 0xFF0000 or img.blue_mask != 0xFF:
        fail("DISPLAY_UNAVAILABLE", f"unsupported pixel format ({img.bits_per_pixel} bpp)")
    stride = img.bytes_per_line
    data = ctypes.string_at(img.data, stride * height)
    pointer = [ctypes.c_int() for _ in range(4)]
    ignored = [ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_uint()]
    x.XQueryPointer(display, root, ctypes.byref(ignored[0]), ctypes.byref(ignored[1]),
                    ctypes.byref(pointer[0]), ctypes.byref(pointer[1]),
                    ctypes.byref(pointer[2]), ctypes.byref(pointer[3]), ctypes.byref(ignored[2]))
    x.XDestroyImage(image)
    x.XCloseDisplay(display)
    captured_at = time.time()
    for scale in (1, 2, 3, 4):
        w, h = width // scale, height // scale
        rows = []
        for y in range(h):
            line = data[y * scale * stride: y * scale * stride + width * 4]
            # BGRX little-endian pixels, every `scale`th one.
            rgb = bytearray(w * 3)
            step = 4 * scale
            rgb[0::3] = line[2::step][:w]
            rgb[1::3] = line[1::step][:w]
            rgb[2::3] = line[0::step][:w]
            rows.append(bytes(rgb))
        encoded = png(w, h, rows)
        if len(encoded) <= max_bytes:
            break
    else:
        fail("IMAGE_TOO_LARGE", f"the screenshot is over {max_bytes} bytes even at 1/4 size", 4)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(encoded)
    print(json.dumps({
        "screen_width": width, "screen_height": height,
        "image_width": w, "image_height": h, "scale": scale,
        "pointer": [pointer[0].value, pointer[1].value],
        "bytes": len(encoded), "sha256": hashlib.sha256(encoded).hexdigest(),
        "captured_at": captured_at,
    }))


main(sys.argv[1:])
