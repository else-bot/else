#!/usr/bin/env python3
"""Pointer and keyboard input on the desktop (X display :99, the one VNC serves).

Usage: ELSE_INPUT_BATCH=JSON else-input   (the batch never appears in arguments)
       else-input --release-all              (release every held key and button)
The JSON is {"frame": [WIDTH, HEIGHT], "actions": [...]}, coordinates in screen
pixels. Actions:
  {"move": [x, y]}
  {"click": [x, y], "button": "left"|"middle"|"right", "count": 1-3}
  {"drag": [x1, y1, x2, y2]}
  {"scroll": [x, y], "dy": -10..10, "dx": -10..10}   (positive dy scrolls down)
  {"key": "ctrl+l"}            a key or chord, pressed together then released
  {"type": "text"}             literal text, character by character
  {"wait": 0.1-5}              seconds
The whole batch is checked before anything happens (every key name resolved,
every point inside the screen), the desktop lock that browser scripts and
computer_browser take is acquired, and then the display must still be
WIDTH x HEIGHT (else SCREEN_CHANGED: take a new screenshot) and no VNC viewer
may be connected to the controlling VNC server on 5900 (OWNER_USING_DESKTOP;
the view-only server on 5901 that the in-app viewer watches is ignored). Only then does it print
{"started": true}; a failure before that did nothing. After it, one line per
completed action; a failure prints an error and the done lines tell what
happened. The screen size and VNC connections are checked again before each
action. Whatever it pressed is released at the end, on an error, and on
SIGTERM (a forced kill is covered by --release-all, which every guest kill
runs). Errors never repeat the supplied values. Uses libX11 and libXtst
through ctypes; nothing touches any other display.
"""
import base64
import ctypes
import ctypes.util
import fcntl
import json
import os
import signal
import sys
import time

LOCK = "/var/lib/elsebot/browser.lock"
NAMES = {
    "ctrl": "Control_L", "control": "Control_L", "shift": "Shift_L", "alt": "Alt_L",
    "super": "Super_L", "meta": "Super_L", "win": "Super_L", "enter": "Return",
    "return": "Return", "esc": "Escape", "escape": "Escape", "tab": "Tab",
    "backspace": "BackSpace", "delete": "Delete", "del": "Delete", "insert": "Insert",
    "space": "space", "up": "Up", "down": "Down", "left": "Left", "right": "Right",
    "home": "Home", "end": "End", "pageup": "Prior", "pagedown": "Next",
    **{f"f{i}": f"F{i}" for i in range(1, 13)},
}
BUTTONS = {"left": 1, "middle": 2, "right": 3}


def emit(obj):
    print(json.dumps(obj), flush=True)


STARTED = False


def fail(code, message, status=3):
    emit({"error": f"{code}: {message}"})
    # After execution started, any failure leaves what is done in doubt.
    sys.exit(5 if STARTED else status)


def vnc_viewer_connected():
    """Whether a VNC client (the owner, through noVNC) holds a connection to
    x11vnc on guest port 5900 right now."""
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(table) as f:
                for line in f.readlines()[1:]:
                    cols = line.split()
                    if cols[3] == "01" and cols[1].endswith(":170C"):
                        return True
        except OSError:
            pass
    return False


class Input:
    def __init__(self):
        try:
            self.x = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
            self.t = ctypes.cdll.LoadLibrary(ctypes.util.find_library("Xtst") or "libXtst.so.6")
        except OSError as e:
            fail("DISPLAY_UNAVAILABLE", f"X libraries are missing ({e})")
        x, t = self.x, self.t
        x.XOpenDisplay.restype = ctypes.c_void_p
        x.XOpenDisplay.argtypes = [ctypes.c_char_p]
        for name in ("XDefaultScreen", "XFlush", "XCloseDisplay"):
            getattr(x, name).argtypes = [ctypes.c_void_p]
        x.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        x.XDisplayWidth.argtypes = x.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
        x.XStringToKeysym.restype = ctypes.c_ulong
        x.XStringToKeysym.argtypes = [ctypes.c_char_p]
        x.XKeysymToKeycode.restype = ctypes.c_ubyte
        x.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        x.XKeycodeToKeysym.restype = ctypes.c_ulong
        x.XKeycodeToKeysym.argtypes = [ctypes.c_void_p, ctypes.c_ubyte, ctypes.c_int]
        x.XChangeKeyboardMapping.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
                                             ctypes.POINTER(ctypes.c_ulong), ctypes.c_int]
        x.XDisplayKeycodes.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)]
        t.XTestFakeMotionEvent.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_ulong]
        t.XTestFakeButtonEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
        t.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
        self.d = x.XOpenDisplay(b":99")
        if not self.d:
            fail("DISPLAY_UNAVAILABLE", "the desktop display is not running")
        screen = x.XDefaultScreen(self.d)
        self.size = (x.XDisplayWidth(self.d, screen), x.XDisplayHeight(self.d, screen))
        x.XDefaultRootWindow.restype = ctypes.c_ulong
        x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        self.root = x.XDefaultRootWindow(self.d)
        x.XGetGeometry.argtypes = [ctypes.c_void_p, ctypes.c_ulong] + [ctypes.c_void_p] * 7
        x.XQueryPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong] + [ctypes.c_void_p] * 7
        x.XQueryKeymap.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
        self.keys, self.buttons = set(), set()
        # Spare keycodes in use: keysym -> keycode; all restored to empty.
        self.spares = {}

    def current_size(self):
        """The root window's size now (it changes if the screen is resized)."""
        r, u = ctypes.c_ulong(), [ctypes.c_int() for _ in range(2)]
        w, h, b, d = (ctypes.c_uint() for _ in range(4))
        self.x.XGetGeometry(self.d, self.root, ctypes.byref(r), ctypes.byref(u[0]), ctypes.byref(u[1]),
                            ctypes.byref(w), ctypes.byref(h), ctypes.byref(b), ctypes.byref(d))
        return (w.value, h.value)

    def modifier_mask(self):
        u = [ctypes.c_ulong(), ctypes.c_ulong()]
        i = [ctypes.c_int() for _ in range(4)]
        m = ctypes.c_uint()
        self.x.XQueryPointer(self.d, self.root, *[ctypes.byref(v) for v in u + i], ctypes.byref(m))
        return m.value

    def sync(self):
        self.x.XSync(self.d, 0)

    def move(self, px, py):
        self.t.XTestFakeMotionEvent(self.d, -1, int(px), int(py), 0)
        self.sync()

    def button(self, b, down):
        # Recorded before the press is sent and with SIGTERM blocked, so the
        # cleanup always knows what may be down.
        old = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM})
        try:
            if down:
                self.buttons.add(b)
            self.t.XTestFakeButtonEvent(self.d, b, 1 if down else 0, 0)
            self.sync()
            if not down:
                self.buttons.discard(b)
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, old)

    def key(self, code, down):
        old = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM})
        try:
            if down:
                self.keys.add(code)
            self.t.XTestFakeKeyEvent(self.d, code, 1 if down else 0, 0)
            self.sync()
            if not down:
                self.keys.discard(code)
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, old)

    def release_all(self):
        for code in list(self.keys):
            self.key(code, False)
        for b in list(self.buttons):
            self.button(b, False)
        # Leave the spare keycodes as empty as they were.
        for code in self.spares.values():
            none = (ctypes.c_ulong * 1)(0)
            self.x.XChangeKeyboardMapping(self.d, code, 1, none, 1)
        self.spares.clear()
        self.sync()

    def release_held(self):
        """Release every key and button X reports as held (after a forced
        kill of an input batch)."""
        keymap = (ctypes.c_char * 32)()
        self.x.XQueryKeymap(self.d, keymap)
        for n in range(8, 256):
            if keymap.raw[n // 8] >> (n % 8) & 1:
                self.t.XTestFakeKeyEvent(self.d, n, 0, 0)
        mask = self.modifier_mask()
        for b, bit in ((1, 0x100), (2, 0x200), (3, 0x400), (4, 0x800), (5, 0x1000)):
            if mask & bit:
                self.t.XTestFakeButtonEvent(self.d, b, 0, 0)
        self.sync()

    def keysym(self, name):
        sym = self.x.XStringToKeysym(name.encode())
        if not sym:
            fail("INVALID_KEY", f"unknown key {name!r}", 2)
        return sym

    def code_for(self, sym):
        """A keycode for a keysym, and whether Shift is needed; a keysym the
        keyboard lacks is put on a keycode with no mapping at any level."""
        code = self.x.XKeysymToKeycode(self.d, sym)
        if code and code not in self.spares.values():
            if self.x.XKeycodeToKeysym(self.d, code, 0) == sym:
                return code, False
            if self.x.XKeycodeToKeysym(self.d, code, 1) == sym:
                return code, True
        if sym in self.spares:
            return self.spares[sym], False
        lo, hi = ctypes.c_int(), ctypes.c_int()
        self.x.XDisplayKeycodes(self.d, ctypes.byref(lo), ctypes.byref(hi))
        spare = next((c for c in range(hi.value, lo.value - 1, -1)
                      if c not in self.spares.values()
                      and not any(self.x.XKeycodeToKeysym(self.d, c, i) for i in range(4))), None)
        if spare is None:
            fail("INVALID_TEXT", "no spare keycode to type a character")
        syms = (ctypes.c_ulong * 1)(sym)
        self.x.XChangeKeyboardMapping(self.d, spare, 1, syms, 1)
        self.spares[sym] = spare
        self.sync()
        time.sleep(0.05)
        return spare, False

    def chord(self, text):
        """Press a key or chord together, then release in reverse; a key
        that needs Shift (such as %) gets it."""
        shift = self.x.XKeysymToKeycode(self.d, self.keysym("Shift_L"))
        codes = []
        for sym in chord_keysyms(text):
            code, needs_shift = self.code_for(sym)
            if needs_shift and shift not in codes:
                codes.append(shift)
            codes.append(code)
        for c in codes:
            self.key(c, True)
        for c in reversed(codes):
            self.key(c, False)

    def type(self, text):
        """Literal text: Caps Lock is turned off for it and restored, so case
        is exactly as given (no modifier of ours is held: each key is
        released before the next)."""
        shift = self.x.XKeysymToKeycode(self.d, self.keysym("Shift_L"))
        caps = self.x.XKeysymToKeycode(self.d, self.keysym("Caps_Lock"))
        locked = bool(self.modifier_mask() & 0x2)
        if locked:
            self.key(caps, True)
            self.key(caps, False)
        try:
            self._type(text, shift)
        finally:
            if locked:
                self.key(caps, True)
                self.key(caps, False)

    def _type(self, text, shift):
        for ch in text:
            if ch == "\n":
                sym = self.keysym("Return")
            elif ch == "\t":
                sym = self.keysym("Tab")
            else:
                cp = ord(ch)
                sym = cp if 0x20 <= cp <= 0x7E or 0xA0 <= cp <= 0xFF else 0x01000000 + cp
            code, needs_shift = self.code_for(sym)
            if needs_shift:
                self.key(shift, True)
            self.key(code, True)
            self.key(code, False)
            if needs_shift:
                self.key(shift, False)
            time.sleep(0.008)


def chord_keysyms(text):
    """The keysyms of a key or chord such as ctrl+shift+t, or INVALID_KEY.
    Needs no display, so a whole batch is checked before anything happens."""
    x = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
    x.XStringToKeysym.restype = ctypes.c_ulong
    x.XStringToKeysym.argtypes = [ctypes.c_char_p]
    parts = [p for p in text.replace(" ", "").split("+") if p]
    if not parts:
        return None
    syms = []
    for p in parts:
        if len(p) == 1:
            syms.append(ord(p.lower()) if p.isalpha() else ord(p))
            continue
        sym = x.XStringToKeysym(NAMES.get(p.lower(), p).encode())
        if not sym:
            return None
        syms.append(sym)
    return syms


def point(index, name, values, size, count=2):
    if not isinstance(values, list) or len(values) != count or not all(isinstance(v, (int, float)) for v in values):
        fail("INVALID_ACTION", f"action {index + 1}: {name} needs {count} numbers", 2)
    for i in range(0, count, 2):
        if not (0 <= values[i] < size[0] and 0 <= values[i + 1] < size[1]):
            fail("OUT_OF_BOUNDS", f"action {index + 1}: {name} {values[i]},{values[i + 1]} is outside the {size[0]}x{size[1]} screen", 2)


def check(batch, size):
    frame = batch.get("frame")
    if not (isinstance(frame, list) and len(frame) == 2):
        fail("INVALID_ACTION", "frame [width, height] from the latest screenshot is required", 2)
    if tuple(frame) != tuple(size):
        fail("SCREEN_CHANGED", f"the screen is now {size[0]}x{size[1]}, not {frame[0]}x{frame[1]}; take a new screenshot", 2)
    if not isinstance(batch.get("actions"), list):
        fail("INVALID_ACTION", "actions is a list", 2)
    actions = batch.get("actions")
    if not isinstance(actions, list) or not 1 <= len(actions) <= 20:
        fail("INVALID_ACTION", "1 to 20 actions", 2)
    for n, a in enumerate(actions):
        if not isinstance(a, dict) or len([k for k in a if k in ("move", "click", "drag", "scroll", "key", "type", "wait")]) != 1:
            fail("INVALID_ACTION", f"action {n + 1}: exactly one of move, click, drag, scroll, key, type, wait", 2)
        if "move" in a:
            point(n, "move", a["move"], size)
        elif "click" in a:
            point(n, "click", a["click"], size)
            if a.get("button", "left") not in BUTTONS or a.get("count", 1) not in (1, 2, 3):
                fail("INVALID_ACTION", f"action {n + 1}: button left|middle|right, count 1-3", 2)
        elif "drag" in a:
            point(n, "drag", a["drag"], size, 4)
        elif "scroll" in a:
            point(n, "scroll", a["scroll"], size)
            for k in ("dx", "dy"):
                if not isinstance(a.get(k, 0), int) or abs(a.get(k, 0)) > 10:
                    fail("INVALID_ACTION", f"action {n + 1}: {k} is -10 to 10", 2)
        elif "key" in a:
            if not isinstance(a["key"], str) or not 0 < len(a["key"]) <= 64 or not chord_keysyms(a["key"]):
                fail("INVALID_KEY", f"action {n + 1}: not a key name or chord such as ctrl+l or Enter", 2)
        elif "type" in a:
            if not isinstance(a["type"], str) or not 0 < len(a["type"]) <= 2000:
                fail("INVALID_ACTION", f"action {n + 1}: type is 1 to 2000 characters", 2)
        elif "wait" in a:
            if not isinstance(a["wait"], (int, float)) or not 0 < a["wait"] <= 5:
                fail("INVALID_ACTION", f"action {n + 1}: wait is up to 5 seconds", 2)
    return actions


def run(inp, actions, frame):
    for i, a in enumerate(actions):
        if inp.current_size() != tuple(frame):
            fail("SCREEN_CHANGED", "the screen was resized during the batch; take a new screenshot")
        if vnc_viewer_connected():
            fail("OWNER_USING_DESKTOP", "the owner connected to the desktop during the batch")
        if "move" in a:
            inp.move(*a["move"])
        elif "click" in a:
            inp.move(*a["click"])
            b = BUTTONS[a.get("button", "left")]
            for _ in range(a.get("count", 1)):
                inp.button(b, True)
                inp.button(b, False)
                time.sleep(0.05)
        elif "drag" in a:
            x1, y1, x2, y2 = a["drag"]
            inp.move(x1, y1)
            inp.button(1, True)
            for step in range(1, 11):
                inp.move(x1 + (x2 - x1) * step / 10, y1 + (y2 - y1) * step / 10)
                time.sleep(0.02)
            inp.button(1, False)
        elif "scroll" in a:
            inp.move(*a["scroll"])
            for b, n in ((5 if a.get("dy", 0) > 0 else 4, abs(a.get("dy", 0))),
                         (7 if a.get("dx", 0) > 0 else 6, abs(a.get("dx", 0)))):
                for _ in range(n):
                    inp.button(b, True)
                    inp.button(b, False)
                    time.sleep(0.03)
        elif "key" in a:
            inp.chord(a["key"])
        elif "type" in a:
            inp.type(a["type"])
        elif "wait" in a:
            time.sleep(a["wait"])
        time.sleep(0.08)
        emit({"done": i})


def main(argv):
    global STARTED
    if argv == ["--release-all"]:
        Input().release_held()
        emit({"released": True})
        return
    raw = os.environ.pop("ELSE_INPUT_BATCH", None)
    if argv or raw is None:
        fail("USAGE", "the batch comes in ELSE_INPUT_BATCH", 2)
    try:
        batch = json.loads(raw)
    except Exception:  # noqa: BLE001
        fail("INVALID_ACTION", "the batch is not JSON", 2)
    if not isinstance(batch, dict):
        fail("INVALID_ACTION", "the batch is an object", 2)
    inp = Input()
    actions = check(batch, inp.current_size())
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.monotonic() + 20
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            if time.monotonic() > deadline:
                fail("DESKTOP_BUSY", "a script controls the browser or desktop; wait for it or cancel its job")
            time.sleep(0.2)
    # The wait may have taken a while: check the screen and the owner again.
    check(batch, inp.current_size())
    if vnc_viewer_connected():
        fail("OWNER_USING_DESKTOP", "the owner is connected to the desktop; wait until they leave", 2)

    def stop(*_):
        inp.release_all()
        emit({"error": "STOPPED: the input was stopped; what is listed as done happened"})
        os._exit(143)

    signal.signal(signal.SIGTERM, stop)
    STARTED = True
    emit({"started": True})
    try:
        run(inp, actions, batch["frame"])
    finally:
        inp.release_all()
    emit({"ok": True, "actions": len(actions)})


main(sys.argv[1:])
