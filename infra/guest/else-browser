#!/usr/bin/env python3
"""Drive the guest's Chromium through DevTools on guest loopback.

Usage: else-browser [--accept-dialogs] open URL | text | title | snapshot | click SELECTOR | type SELECTOR TEXT | reconcile
SELECTOR is CSS, text=Label for the one visible element with exactly that text,
or a ref such as @kqvzb3 from the latest snapshot of the same page.
Prints one JSON object. Runs inside the guest; nothing leaves the VM.

A native dialog (alert, confirm, prompt, "Leave site?") is answered in the same
call, since a later connection can neither see nor answer it: dismissed by
default, so a page that asks to confirm leaving keeps its input, or accepted
with --accept-dialogs. The result lists the dialogs answered.
"""
import difflib, fcntl, json, os, random, string, subprocess, sys, time, urllib.parse, urllib.request
import websocket

DEVTOOLS = "http://127.0.0.1:9222"

def page():
    # The desktop starts on first use; a browser that is restarting comes
    # back by itself.
    if not os.path.exists("/tmp/.X11-unix/X99") and os.access("/usr/local/bin/else-desktop", os.X_OK):
        subprocess.run(["/usr/local/bin/else-desktop"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=30, check=False)
    for _ in range(50):
        try:
            tabs = json.load(urllib.request.urlopen(DEVTOOLS + "/json/list", timeout=2))
            pages = [t for t in tabs if t.get("type") == "page"]
            if pages:
                return pages[0]
        except Exception:
            pass
        time.sleep(0.2)
    raise SystemExit(json.dumps({"error": "the browser is not ready"}))

class Tab:
    def __init__(self, accept_dialogs):
        target = page()
        self.id = target["id"]
        self.ws = websocket.create_connection(target["webSocketDebuggerUrl"], timeout=5)
        self.n = 0
        self.accept_dialogs = accept_dialogs
        self.dialogs = []
        try:
            self.call("Page.enable")
        except websocket.WebSocketTimeoutException:
            raise SystemExit(json.dumps({"error": f"DIALOG_OPEN: the tab {target.get('url')} does not answer; a native "
                                         "dialog may be open on it. Take a screenshot and answer it with computer_input"}))
        self.ws.settimeout(20)
    def call(self, method, **params):
        self.n += 1
        call_id = self.n
        self.ws.send(json.dumps({"id": call_id, "method": method, "params": params}))
        while True:
            msg = json.loads(self.ws.recv())
            if msg.get("method") == "Page.javascriptDialogOpening":
                self.answer(msg["params"])
            elif msg.get("id") == call_id:
                if "error" in msg:
                    raise SystemExit(json.dumps({"error": msg["error"].get("message")}))
                return msg.get("result", {})
    def answer(self, dialog):
        """The dialog pauses the call that is waiting; its reply follows."""
        self.n += 1
        self.ws.send(json.dumps({"id": self.n, "method": "Page.handleJavaScriptDialog",
                                 "params": {"accept": self.accept_dialogs}}))
        self.dialogs.append({"type": dialog.get("type"), "message": dialog.get("message", "")[:500],
                             "answer": "accepted" if self.accept_dialogs else "dismissed"})
    def on(self, element, function):
        r = self.call("Runtime.callFunctionOn", objectId=element, functionDeclaration=function,
                      returnByValue=True, awaitPromise=True)
        return r.get("result", {}).get("value")
    def eval(self, expression):
        r = self.call("Runtime.evaluate", expression=expression, returnByValue=True, awaitPromise=True)
        return r.get("result", {}).get("value")
    def settle(self):
        for _ in range(100):
            if self.eval("document.readyState") == "complete":
                return
            time.sleep(0.1)

LOCK = "/var/lib/elsebot/browser.lock"
CONTROLLED = "/var/lib/elsebot/browser-controlled.jsonl"
REFS = "/var/lib/elsebot/browser-refs.json"

def reconcile():
    """After a script was stopped (run by every guest kill): the tabs a
    script that no longer runs opened are closed, and code in the tabs it
    attached to is halted, so its browser work does not outlive it."""
    try:
        with open(CONTROLLED) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        print(json.dumps({"closed": 0, "halted": 0}))
        return
    keep, orphans = [], []
    for line in lines:
        try:
            entry = json.loads(line)
            os.kill(int(entry["pid"]), 0)
            keep.append(line)
        except ProcessLookupError:
            orphans.append(entry)
        except Exception:
            pass
    closed = halted = 0
    errors = []
    try:
        tabs = {t["id"]: t for t in json.load(urllib.request.urlopen(DEVTOOLS + "/json/list", timeout=2))}
    except Exception:
        tabs = {}
    for entry in orphans:
        tab = tabs.get(entry.get("target"))
        if not tab:
            continue
        try:
            if entry.get("created"):
                urllib.request.urlopen(DEVTOOLS + "/json/close/" + tab["id"], timeout=2).read()
                closed += 1
            else:
                ws = websocket.create_connection(tab["webSocketDebuggerUrl"], timeout=5)
                for n, method in enumerate(["Runtime.terminateExecution", "Page.stopLoading"], 1):
                    ws.send(json.dumps({"id": n, "method": method, "params": {}}))
                    deadline = time.monotonic() + 5
                    while time.monotonic() < deadline:
                        if json.loads(ws.recv()).get("id") == n:
                            break
                ws.close()
                halted += 1
        except Exception as e:
            errors.append(f"{type(e).__name__}: {e}")
    with open(CONTROLLED, "w") as f:
        f.write("".join(l + "\n" for l in keep))
    result = {"closed": closed, "halted": halted, "orphans": len(orphans), "errors": errors}
    try:
        with open("/var/lib/elsebot/browser-reconcile.log", "a") as f:
            f.write(json.dumps(result) + "\n")
    except OSError:
        pass
    print(json.dumps(result))

def lock():
    """The browser lock CDP scripts also take (one controller at a time)."""
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.monotonic() + 20
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() > deadline:
                raise SystemExit(json.dumps({"error": "BROWSER_BUSY: a script is controlling the browser "
                                             "(see computer_job); wait for it or cancel it"}))
            time.sleep(0.2)

BY_TEXT = r"""(q)=>{
const norm=s=>(s||'').replace(/\s+/g,' ').trim();
q=norm(q);
const low=q.toLowerCase(),bare=low.replace(/ /g,'');
const named=e=>e.hasAttribute('aria-label')||!!e.placeholder||e.tagName==='INPUT';
const name=e=>norm(e.getAttribute('aria-label'))||(e.tagName==='INPUT'&&/^(submit|button|reset)$/.test(e.type)
 ?norm(e.value):norm(e.placeholder)||norm(e.innerText));
const visible=e=>e.getClientRects().length>0&&getComputedStyle(e).visibility!=='hidden';
const exact=[],near=[];
const walk=root=>{const it=document.createTreeWalker(root,NodeFilter.SHOW_ELEMENT);
 for(let e=it.nextNode();e;e=it.nextNode()){
  if(e.shadowRoot)walk(e.shadowRoot);
  if(/^(HEAD|SCRIPT|STYLE|HTML|BODY)$/.test(e.tagName))continue;
  if(!named(e)){const t=e.textContent.replace(/\s+/g,'').toLowerCase();if(!t.includes(bare))continue}
  const n=name(e);
  if(n.length>q.length+40||!n.toLowerCase().includes(low)||!visible(e))continue;
  (n===q?exact:near).push(e);
 }};
walk(document);
const deepest=a=>a.filter(e=>!a.some(o=>o!==e&&e.contains(o)));
const hits=deepest(exact);
if(hits.length===1)return {el:hits[0]};
const tag=e=>{const h=(e.closest('a,button,label,input,select,textarea,[role]')||e).outerHTML;
 return h.slice(0,Math.min(h.indexOf('>')+1,160))};
if(hits.length)return {state:'several',count:hits.length,tags:hits.slice(0,5).map(tag)};
return {state:'missing',near:[...new Set(deepest(near).map(name))].slice(0,5)};
}"""

def find(tab, selector):
    """The one element a selector names, as a remote object ID."""
    if selector.startswith("@"):
        return from_ref(tab, selector)
    if selector.startswith("text="):
        label = selector[5:].strip()
        if len(label) > 1 and label[0] == label[-1] and label[0] in "\"'":
            label = label[1:-1]
        body = f"const r=({BY_TEXT})({json.dumps(label)});return r.el||r;"
    else:
        label = None
        body = (f"let e;try{{e=document.querySelector({json.dumps(selector)})}}catch(_){{return {{state:'invalid'}}}}"
                "return e||{state:'missing'};")
    result = tab.call("Runtime.evaluate", expression=f"(()=>{{{body}}})()")["result"]
    if result.get("subtype") == "node":
        return result["objectId"]
    found = tab.on(result["objectId"], "function(){return this}") if "objectId" in result else {}
    state = found.get("state")
    if state == "invalid":
        error = (f"{json.dumps(selector)} is not a CSS selector; use CSS such as #id, .class, or "
                 "button[type=submit], or text=Label, not XPath")
    elif state == "several":
        error = (f"{found['count']} visible elements have the text {json.dumps(label)}, in page order: "
                 f"{', '.join(found['tags'])}; use a CSS selector")
    elif label is None:
        error = "no element matches the CSS selector"
    else:
        similar = ", ".join(json.dumps(n) for n in found.get("near", []))
        error = f"no visible element has the text {json.dumps(label)}" + (f"; similar: {similar}" if similar else "")
    raise SystemExit(json.dumps({"error": error}))

ACTIONS = open("/usr/local/lib/elsebot/cdp/actions.js").read()

def page_step(tab, element, step, *args):
    """Run one of the steps in actions.js on the element."""
    return tab.on(element, f"function(){{return ({ACTIONS}).{step}.call(this,...{json.dumps(args)})}}")

def field_of(tab, element):
    """The field to type into, resolved once (see field in actions.js)."""
    r = tab.call("Runtime.callFunctionOn", objectId=element, returnByValue=False,
                 functionDeclaration=f"function(){{return ({ACTIONS}).field.call(this)}}")
    return r["result"]["objectId"]

def click(tab, element, selector):
    point = page_step(tab, element, "clickPoint")
    if "error" not in point:
        tab.call("Input.dispatchMouseEvent", type="mouseMoved", x=point["x"], y=point["y"])
        # Hovering can open a menu or move the page; check the point again.
        point = page_step(tab, element, "clickPoint", point["x"], point["y"])
    if "error" in point:
        raise SystemExit(json.dumps({"error": f"{point['error']} ({json.dumps(selector)})"}))
    for kind in ("mousePressed", "mouseReleased"):
        tab.call("Input.dispatchMouseEvent", type=kind, x=point["x"], y=point["y"], button="left", clickCount=1)

DELETE_KEY = {"key": "Delete", "code": "Delete", "windowsVirtualKeyCode": 46}

def type_into(tab, element, selector, text, secret):
    def fail(error):
        raise SystemExit(json.dumps({"error": f"{json.dumps(selector)}: {error}"}))
    typed = page_step(tab, element, "typeInto", text)
    if "error" in typed:
        fail(typed["error"])
    if typed.get("insert"):
        # Text goes wherever focus is, so check it right before typing.
        if not page_step(tab, element, "focusedField"):
            fail("the page moved focus or the text cursor away from the field, so nothing was typed")
        if text:
            tab.call("Input.insertText", text=text)
        else:
            for kind in ("rawKeyDown", "keyUp"):
                tab.call("Input.dispatchKeyEvent", type=kind, **DELETE_KEY)
    # In its own call, so the page's handlers have finished.
    held = page_step(tab, element, "holds", text if typed.get("insert") else typed["check"], secret,
                     typed.get("index"))
    if "error" in held:
        fail(held["error"])

PAGE_TEXT = "document.body ? document.body.innerText : ''"
TEXT_LIMIT = 20000
CHANGES_LIMIT = 4000

def page_text(tab):
    text = tab.eval(PAGE_TEXT) or ""
    return {"text": text[:TEXT_LIMIT], "text_truncated": len(text) > TEXT_LIMIT}

def changes(before, after):
    """The lines an action added to or removed from the page text."""
    added, removed = [], []
    a, b = before.splitlines(), after.splitlines()
    for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        removed += [l for l in a[i1:i2] if l.strip()] if op in ("replace", "delete") else []
        added += [l for l in b[j1:j2] if l.strip()] if op in ("replace", "insert") else []
    out, size = {}, 0
    for key, lines in (("added", added), ("removed", removed)):
        kept = []
        for line in lines:
            size += len(line) + 1
            if size > CHANGES_LIMIT:
                out["changes_truncated"] = True
                break
            kept.append(line)
        if kept:
            out[key] = kept
    return out

def act(tab, action, expect_change):
    """Run an action on the current page and report what it changed: the new
    page's text when it loaded another document, else the lines that changed."""
    marker = os.urandom(8).hex()
    tab.eval(f"window.__elseDoc = {json.dumps(marker)}")
    before = tab.eval(PAGE_TEXT) or ""
    action()
    time.sleep(0.2)
    tab.settle()
    navigated = lambda: tab.eval("window.__elseDoc") != marker
    if navigated():
        return {"navigated": True, **page_text(tab)}
    after = tab.eval(PAGE_TEXT) or ""
    deadline = time.monotonic() + (1 if expect_change else 0)
    while after == before and time.monotonic() < deadline:
        time.sleep(0.1)
        after = tab.eval(PAGE_TEXT) or ""
    if navigated():
        tab.settle()
        return {"navigated": True, **page_text(tab)}
    diff = changes(before, after)
    if diff or not expect_change:
        return diff
    return {"unchanged": True, "next": "The page text did not change. If the click starts something slow, "
            "read the page again with text; take a screenshot for changes text does not show."}

# Roles a person acts on; each gets a ref. Headings are listed for context.
CONTROLS = {"button", "link", "textbox", "searchbox", "checkbox", "radio", "combobox", "listbox", "option",
            "menuitem", "menuitemcheckbox", "menuitemradio", "slider", "spinbutton", "switch", "tab", "treeitem",
            "Date", "DateTime", "InputTime"}
# Controls whose children are themselves listed (a select's options); the
# parts inside any other control, such as a date input's fields, are not.
CONTAINERS = {"combobox", "listbox"}
STATES = ("disabled", "checked", "pressed", "expanded", "selected", "required")
SNAPSHOT_LIMIT = 16000

# Elements styled as clickable that are not controls, such as a div with an
# onclick handler: the outermost one with text, not inherited from a parent.
CLICKABLE = r"""(()=>{const out=[];if(!document.body)return out;
const skip='a,button,input,select,textarea,summary,details,label,[role],[contenteditable]';
for(const e of document.body.querySelectorAll('*')){
 if(out.length>=100)break;
 if(e.matches(skip)||e.closest('a,button,[role=button],[role=link]'))continue;
 const st=getComputedStyle(e);
 if(st.cursor!=='pointer'&&!e.hasAttribute('onclick'))continue;
 if(e.parentElement&&getComputedStyle(e.parentElement).cursor==='pointer'&&!e.hasAttribute('onclick'))continue;
 const t=(e.innerText||'').replace(/\s+/g,' ').trim();
 if(!t||!e.getClientRects().length||st.visibility==='hidden')continue;
 out.push(e);
}return out})()"""

def clickables(tab):
    """backendNodeId -> visible text of each element CLICKABLE finds."""
    found = tab.call("Runtime.evaluate", expression=CLICKABLE)["result"]
    if "objectId" not in found:
        return {}
    props = tab.call("Runtime.getProperties", objectId=found["objectId"], ownProperties=True)["result"]
    out = {}
    for prop in props:
        oid = prop.get("value", {}).get("objectId")
        if prop["name"].isdigit() and oid:
            node = tab.call("DOM.describeNode", objectId=oid)["node"]
            out[node["backendNodeId"]] = tab.on(oid, "function(){return this.innerText}") or ""
    return out

def clean(value):
    return " ".join(str(value).split())[:100]

def described(node):
    """The role and name a snapshot lists for an accessibility node; an
    element listed only for looking clickable has the role clickable."""
    role = node.get("role", {}).get("value", "")
    props = {p["name"]: p.get("value", {}).get("value") for p in node.get("properties", [])}
    if role not in CONTROLS and "editable" in props:
        role = "textbox"
    if role not in CONTROLS:
        role = "clickable"
    return role.lower(), clean(node.get("name", {}).get("value", "")), props

def document_id(tab):
    return tab.call("Page.getFrameTree")["frameTree"]["frame"]["loaderId"]

def snapshot(tab):
    """The page's controls in page order, one line each, with refs. A link
    shows its URL when another link has the same name, or it has none."""
    tab.call("DOM.enable")
    tab.call("Accessibility.enable")
    nodes = tab.call("Accessibility.getFullAXTree")["nodes"]
    extra = clickables(tab)
    by_id = {n["nodeId"]: n for n in nodes}
    roots = [n for n in nodes if not n.get("parentId") or n["parentId"] not in by_id]
    origin = urllib.parse.urlsplit(tab.eval("location.href") or "")
    entries = []
    def visit(node):
        role, name, props = described(node)
        backend = node.get("backendDOMNodeId")
        listed = not node.get("ignored") and backend and (role != "clickable" or backend in extra)
        if listed:
            states = [k if v in (True, "true") else f"{k}={v}"
                      for k, v in props.items() if k in STATES and v not in (False, "false", None)]
            value = clean(node.get("value", {}).get("value", ""))
            if value and role in ("textbox", "searchbox", "combobox", "spinbutton", "slider"):
                states.append(f"value={json.dumps(value)}")
            if role == "clickable":
                name = name or clean(extra.pop(backend))
            url = urllib.parse.urlsplit(props.get("url") or "")
            if url.netloc == origin.netloc and url.scheme == origin.scheme:
                url = url._replace(scheme="", netloc="")
            entries.append({"role": role, "name": name, "states": states, "backend": backend,
                            "url": urllib.parse.urlunsplit(url)[:120]})
        elif node.get("role", {}).get("value") == "heading" and name and not node.get("ignored"):
            entries.append({"role": "heading", "name": name})
        if listed and role not in CONTAINERS:
            return
        for child in node.get("childIds", []):
            if child in by_id:
                visit(by_id[child])
    for root in roots:
        visit(root)
    links = {}
    for entry in entries:
        if entry["role"] == "link":
            links[entry["name"]] = links.get(entry["name"], 0) + 1
    # A ref is never reused for another element, so an old one fails as
    # stale: numbering continues from the last snapshot, and when that state
    # is lost a new random epoch prefixes the numbers.
    try:
        with open(REFS) as f:
            saved = json.load(f)
        epoch, first = saved["epoch"], int(saved["next"])
    except (OSError, ValueError, TypeError, KeyError):
        epoch, first = "".join(random.choice(string.ascii_lowercase) for _ in range(5)), 1
    lines, refs, size, truncated = [], {}, 0, False
    for entry in entries:
        line = f"{entry['role']} {json.dumps(entry['name'])}"
        if "backend" in entry:
            ref = f"{epoch}{first + len(refs)}"
            states = entry["states"]
            if entry["role"] == "link" and entry["url"] and (not entry["name"] or links[entry["name"]] > 1):
                states = [f"url={entry['url']}", *states]
            line += f" @{ref}" + (f" [{', '.join(states)}]" if states else "")
        size += len(line) + 1
        if size > SNAPSHOT_LIMIT:
            truncated = True
            break
        if "backend" in entry:
            refs[ref] = {"backend": entry["backend"], "role": entry["role"], "name": entry["name"]}
        lines.append(line)
    with open(REFS + ".tmp", "w") as f:
        json.dump({"tab": tab.id, "document": document_id(tab), "epoch": epoch, "next": first + len(refs),
                   "refs": refs}, f)
    os.replace(REFS + ".tmp", REFS)
    result = {"snapshot": "\n".join(lines)}
    if truncated:
        result["snapshot_truncated"] = True
    return result

def from_ref(tab, selector):
    stale = (f"STALE_REF: {selector} is not from the latest snapshot of this page; take a new snapshot "
             "and use its refs")
    try:
        with open(REFS) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        raise SystemExit(json.dumps({"error": stale}))
    entry = saved.get("refs", {}).get(selector[1:])
    if (not isinstance(entry, dict) or saved.get("tab") != tab.id
            or saved.get("document") != document_id(tab)):
        raise SystemExit(json.dumps({"error": stale}))
    tab.call("DOM.enable")
    tab.call("Accessibility.enable")
    try:
        element = tab.call("DOM.resolveNode", backendNodeId=entry["backend"])["object"]["objectId"]
        nodes = tab.call("Accessibility.getPartialAXTree", backendNodeId=entry["backend"],
                         fetchRelatives=False)["nodes"]
    except SystemExit:
        raise SystemExit(json.dumps({"error": stale}))
    # The owner approved the control the snapshot named, so a page that
    # relabels it since then does not get the click.
    role, name, _ = described(nodes[0]) if nodes else ("", "", None)
    if role == "clickable" and not name:
        name = clean(tab.on(element, "function(){return this.innerText}") or "")
    if (role, name) != (entry["role"], entry["name"]):
        raise SystemExit(json.dumps({"error": f"CHANGED_REF: {selector} was {entry['role']} {json.dumps(entry['name'])} "
                                     f"and is now {role} {json.dumps(name)}; take a new snapshot"}))
    return element

def main(argv):
    accept_dialogs = argv[:1] == ["--accept-dialogs"]
    if accept_dialogs:
        argv = argv[1:]
    if not argv:
        raise SystemExit(json.dumps({"error": __doc__.strip()}))
    if argv[0] == "reconcile":
        return reconcile()
    _held = lock()
    tab = Tab(accept_dialogs)
    action, rest = argv[0], argv[1:]
    if action == "open":
        tab.call("Page.navigate", url=rest[0])
        if any(d["type"] == "beforeunload" and d["answer"] == "dismissed" for d in tab.dialogs):
            raise SystemExit(json.dumps({"error": f"NAVIGATION_BLOCKED: {tab.eval('location.href')} asked to confirm "
                                         "leaving, so it stayed open with its input; open again with dialog \"accept\" "
                                         "to discard it"}))
        time.sleep(0.3)
        tab.settle()
        result = page_text(tab)
    elif action == "click":
        element = find(tab, rest[0])
        result = act(tab, lambda: click(tab, element, rest[0]), True)
    elif action == "type":
        element = field_of(tab, find(tab, rest[0]))
        secret = page_step(tab, element, "secret")
        result = act(tab, lambda: type_into(tab, element, rest[0], rest[1], secret), False)
        if not result.get("navigated"):
            result = {"value": page_step(tab, element, "fieldValue", secret), **result}
    elif action == "snapshot":
        result = snapshot(tab)
    elif action in ("text", "title"):
        result = page_text(tab) if action == "text" else {}
    else:
        raise SystemExit(json.dumps({"error": f"unknown action {action}"}))
    print(json.dumps({
        "url": tab.eval("location.href"),
        "title": tab.eval("document.title"),
        **result,
        **({"dialogs": tab.dialogs} if tab.dialogs else {}),
    }))

main(sys.argv[1:])
