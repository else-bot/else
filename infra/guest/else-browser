#!/usr/bin/env python3
"""Drive the guest's Chromium through DevTools on guest loopback.

Usage: else-browser open URL | text | title | click SELECTOR | type SELECTOR TEXT
Prints one JSON object. Runs inside the guest; nothing leaves the VM.
"""
import fcntl, json, os, sys, time, urllib.request
import websocket

DEVTOOLS = "http://127.0.0.1:9222"

def page():
    for _ in range(50):
        try:
            tabs = json.load(urllib.request.urlopen(DEVTOOLS + "/json/list", timeout=2))
            pages = [t for t in tabs if t.get("type") == "page"]
            if pages:
                return pages[0]
        except Exception:
            pass
        time.sleep(0.2)
    raise SystemExit(json.dumps({"error": "the browser is not ready"}))

class Tab:
    def __init__(self):
        self.ws = websocket.create_connection(page()["webSocketDebuggerUrl"], timeout=20)
        self.n = 0
    def call(self, method, **params):
        self.n += 1
        self.ws.send(json.dumps({"id": self.n, "method": method, "params": params}))
        while True:
            msg = json.loads(self.ws.recv())
            if msg.get("id") == self.n:
                if "error" in msg:
                    raise SystemExit(json.dumps({"error": msg["error"].get("message")}))
                return msg.get("result", {})
    def eval(self, expression):
        r = self.call("Runtime.evaluate", expression=expression, returnByValue=True, awaitPromise=True)
        return r.get("result", {}).get("value")
    def settle(self):
        for _ in range(100):
            if self.eval("document.readyState") == "complete":
                return
            time.sleep(0.1)

LOCK = "/var/lib/elsebot/browser.lock"

def lock():
    """The browser lock CDP scripts also take (one controller at a time)."""
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.monotonic() + 20
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() > deadline:
                raise SystemExit(json.dumps({"error": "BROWSER_BUSY: a script is controlling the browser "
                                             "(see computer_job); wait for it or cancel it"}))
            time.sleep(0.2)

def main(argv):
    if not argv:
        raise SystemExit(json.dumps({"error": __doc__.strip()}))
    _held = lock()
    tab = Tab()
    action, rest = argv[0], argv[1:]
    if action == "open":
        tab.call("Page.navigate", url=rest[0])
        time.sleep(0.3)
        tab.settle()
    elif action == "click":
        found = tab.eval(f"(()=>{{const e=document.querySelector({json.dumps(rest[0])});if(!e)return false;e.click();return true}})()")
        if not found:
            raise SystemExit(json.dumps({"error": "no element matches the selector"}))
        time.sleep(0.2)
        tab.settle()
    elif action == "type":
        found = tab.eval(f"(()=>{{const e=document.querySelector({json.dumps(rest[0])});if(!e)return false;e.focus();e.value={json.dumps(rest[1])};e.dispatchEvent(new Event('input',{{bubbles:true}}));return true}})()")
        if not found:
            raise SystemExit(json.dumps({"error": "no element matches the selector"}))
    elif action not in ("text", "title"):
        raise SystemExit(json.dumps({"error": f"unknown action {action}"}))
    text = tab.eval("document.body ? document.body.innerText : ''") or ""
    print(json.dumps({
        "url": tab.eval("location.href"),
        "title": tab.eval("document.title"),
        "text": text[:20000],
        "text_truncated": len(text) > 20000,
    }))

main(sys.argv[1:])
