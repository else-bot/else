#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: elsebot <command>

  status            the installed and running versions, and whether the API is up
  version           the installed version
  update [options]  install the latest release (options: install.sh --help)
  reset [--yes]     erase local history, memory, credentials, projects and computers
  remove [--yes]    uninstall the app, server and all local else.bot data
  desktop           open the desktop app
  start | stop | restart
                    the API service (stop is graceful: running turns end as Stopped)
  logs              follow the API log
  api <args>        run else-api with this installation's settings, e.g. elsebot api backup
  db [sqlite3 args]    read-only SQL on this installation's database, e.g. elsebot db 'select count(*) from bots'
  paths             where everything is
EOF
}

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
	directory="$(cd "$(dirname "$self")" && pwd -P)"
	target="$(readlink "$self")"
	case "$target" in /*) self="$target" ;; *) self="$directory/$target" ;; esac
done
self="$(cd "$(dirname "$self")" && pwd -P)/$(basename "$self")"
ELSE_HOME="${ELSE_HOME:-$(cd "$(dirname "$self")/.." && pwd -P)}"
CONFIG="$ELSE_HOME/config"
CURRENT="$ELSE_HOME/current"
APP_CURRENT="$ELSE_HOME/app-current"
SERVER_CURRENT="$ELSE_HOME/server-current"
[ -e "$APP_CURRENT" ] || [ -L "$APP_CURRENT" ] || APP_CURRENT="$CURRENT"
[ -e "$SERVER_CURRENT" ] || [ -L "$SERVER_CURRENT" ] || SERVER_CURRENT="$CURRENT"
LOGS="$ELSE_HOME/logs"
RUN="$ELSE_HOME/run"
ELSEBOT_SERVICE=else-api
ELSEBOT_MANAGER=process
ELSEBOT_AUTOSTART=0
ELSEBOT_APP=""
# shellcheck disable=SC1091
[ -f "$CONFIG/elsebot.env" ] && . "$CONFIG/elsebot.env"

die() { echo "elsebot: $1" >&2; exit 1; }
dotenv_value() {
	local in="$1" out="" quote="" c i
	for ((i = 0; i < ${#in}; i++)); do
		c="${in:i:1}"
		if [ "$quote" = "'" ]; then
			if [ "$c" = "'" ]; then quote=""; else out+="$c"; fi
		elif [ "$c" = '\' ]; then
			i=$((i + 1))
			c="${in:i:1}"
			if [ "$c" = n ]; then out+=$'\n'; else out+="$c"; fi
		elif [ "$quote" = '"' ]; then
			if [ "$c" = '"' ]; then quote=""; else out+="$c"; fi
		elif [ "$c" = "'" ] || [ "$c" = '"' ]; then
			quote="$c"
		elif [ "$c" = ' ' ] || [ "$c" = $'\t' ]; then
			break
		else
			out+="$c"
		fi
	done
	printf '%s' "$out"
}
setting() { [ -f "$CONFIG/.env" ] && dotenv_value "$(sed -n "s/^$1=//p" "$CONFIG/.env" | tail -1)"; }
api_addr() { local bind; bind="$(setting ELSE_API_BIND)"; echo "${bind:-127.0.0.1:7878}"; }
installed() {
	local pointer="$SERVER_CURRENT"
	[ "$1" != else-desktop ] || pointer="$APP_CURRENT"
	[ -x "$pointer/bin/$1" ] && "$pointer/bin/$1" --version 2>/dev/null | awk '{print $2}'
}
running_version() {
	curl -fsS --max-time 3 "http://$(api_addr)/healthz" 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*/\1/p'
}


unit_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$ELSEBOT_SERVICE.service"; }

# --- launchd (macOS): an agent in the owner's login session, which has the
# Keychain that Claude Code keeps its login in.

LABEL="bot.else.$ELSEBOT_SERVICE"
# Loaded at login only from ~/Library/LaunchAgents. Without autostart it is
# kept in the configuration, and `elsebot start` loads it from there: the
# crash restart (KeepAlive) implies RunAtLoad, so RunAtLoad cannot say no.
login_plist() { echo "$HOME/Library/LaunchAgents/$LABEL.plist"; }
plist_file() {
	if [ "$ELSEBOT_AUTOSTART" = 1 ]; then login_plist; else echo "$CONFIG/$LABEL.plist"; fi
}
# The login session's domain; over SSH without one, the user's background one.
launchd_domain() {
	if launchctl print "gui/$(id -u)" >/dev/null 2>&1; then echo "gui/$(id -u)"; else echo "user/$(id -u)"; fi
}
launchd_loaded() { launchctl print "$(launchd_domain)/$LABEL" >/dev/null 2>&1; }
launchd_pid() {
	launchctl print "$(launchd_domain)/$LABEL" 2>/dev/null | awk '$1 == "pid" && $2 == "=" {print $3; exit}'
}
xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

launchd_install() {
	local plist
	plist="$(plist_file)"
	mkdir -p "$(dirname "$plist")" "$LOGS"
	# Started when loaded, restarted after a failure (not after a clean
	# stop), as with systemd; 90 s for a graceful stop before launchd kills it.
	cat >"$plist.tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$(xml "$LABEL")</string>
	<key>ProgramArguments</key>
	<array>
		<string>$(xml "$SERVER_CURRENT/bin/else-api")</string>
		<string>serve</string>
	</array>
	<key>WorkingDirectory</key>
	<string>$(xml "$CONFIG")</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>$(xml "$ELSE_HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin")</string>
	</dict>
	<key>StandardOutPath</key>
	<string>$(xml "$LOGS/else-api.log")</string>
	<key>StandardErrorPath</key>
	<string>$(xml "$LOGS/else-api.log")</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>ExitTimeOut</key>
	<integer>90</integer>
	<key>ProcessType</key>
	<string>Standard</string>
</dict>
</plist>
EOF
	plutil -lint -s "$plist.tmp" || { rm -f "$plist.tmp"; die "the launchd agent is not a valid property list"; }
	mv -f "$plist.tmp" "$plist"
	if [ "$plist" = "$(login_plist)" ]; then rm -f "$CONFIG/$LABEL.plist"; else rm -f "$(login_plist)"; fi
}

launchd_start() {
	local domain
	domain="$(launchd_domain)"
	# A loaded agent keeps the definition it was loaded with: reload it.
	if launchd_loaded && [ -z "$(launchd_pid)" ]; then
		launchctl bootout "$domain/$LABEL" 2>/dev/null || true
	fi
	launchd_loaded || launchctl bootstrap "$domain" "$(plist_file)" ||
		die "launchctl could not load $(plist_file)"
	launchctl kickstart "$domain/$LABEL" >/dev/null
}

# Unloaded until the next start or login: bootout sends SIGTERM and kills
# after ExitTimeOut; wait for the API's own shutdown.
launchd_stop() {
	launchd_loaded || return 0
	local pid _
	pid="$(launchd_pid)"
	launchctl bootout "$(launchd_domain)/$LABEL" 2>/dev/null || true
	[ -n "$pid" ] || return 0
	for _ in $(seq 1 95); do
		kill -0 "$pid" 2>/dev/null || return 0
		sleep 1
	done
	echo "elsebot: the API did not stop within 95 s" >&2
	return 1
}

service_install() {
	if [ "$ELSEBOT_MANAGER" = launchd ]; then
		launchd_install
		return
	fi
	[ "$ELSEBOT_MANAGER" = systemd ] || return 0
	local unit
	unit="$(unit_file)"
	mkdir -p "$(dirname "$unit")"
	cat >"$unit" <<EOF
[Unit]
Description=else.bot API
After=network-online.target

[Service]
WorkingDirectory=$CONFIG
ExecStart=$SERVER_CURRENT/bin/else-api serve
Environment=PATH=$ELSE_HOME/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=default.target
EOF
	systemctl --user daemon-reload
	if [ "$ELSEBOT_AUTOSTART" = 1 ]; then
		systemctl --user enable "$ELSEBOT_SERVICE.service" >/dev/null 2>&1
	else
		systemctl --user disable "$ELSEBOT_SERVICE.service" >/dev/null 2>&1 || true
	fi
}

pid_file() { echo "$RUN/$ELSEBOT_SERVICE.pid"; }

process_pid() {
	local pid executable installation
	pid="$(cat "$(pid_file)" 2>/dev/null)" || return 1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
	installation="$(cd "$ELSE_HOME" && pwd -P)" || return 1
	executable="$(readlink "/proc/$pid/exe" 2>/dev/null || ps -ww -o comm= -p "$pid" 2>/dev/null)" || return 1
	# macOS reports the path the API was launched with, which may go through
	# a symlink such as /var -> /private/var.
	executable="$(cd "${executable%/*}" 2>/dev/null && pwd -P)/${executable##*/}" || return 1
	case "$executable" in
	"$installation/versions/"*/bin/else-api | "$installation/current/bin/else-api" | "$installation/server-current/bin/else-api") ;;
	*) return 1 ;;
	esac
	case "$(tr '\0' ' ' 2>/dev/null <"/proc/$pid/cmdline" || ps -o command= -p "$pid" 2>/dev/null)" in
	*else-api*serve*) echo "$pid" ;;
	*) return 1 ;;
	esac
}

need_api() {
	[ -x "$SERVER_CURRENT/bin/else-api" ] && return 0
	[ -x "$APP_CURRENT/bin/else-desktop" ] &&
		die "this installation in $ELSE_HOME has only the app; add the server with: elsebot update --server-only"
	die "else.bot is not installed in $ELSE_HOME"
}

start() {
	need_api
	case "$ELSEBOT_MANAGER" in
	systemd) systemctl --user start "$ELSEBOT_SERVICE.service"; return ;;
	launchd) launchd_start; return ;;
	esac
	process_pid >/dev/null && return 0
	mkdir -p "$RUN" "$LOGS"
	(
		cd "$CONFIG"
		# Its own session, detached from this terminal. macOS has no setsid
		# command: perl (part of macOS) calls setsid(2) and execs the API, so
		# the pid stays the API's.
		if command -v setsid >/dev/null 2>&1; then
			nohup setsid "$SERVER_CURRENT/bin/else-api" serve >>"$LOGS/else-api.log" 2>&1 </dev/null &
		else
			nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!"' \
				"$SERVER_CURRENT/bin/else-api" serve >>"$LOGS/else-api.log" 2>&1 </dev/null &
		fi
		echo $! >"$(pid_file)"
	)
}

stop() {
	case "$ELSEBOT_MANAGER" in
	systemd) systemctl --user stop "$ELSEBOT_SERVICE.service"; return ;;
	launchd) launchd_stop; return ;;
	esac
	local pid _
	pid="$(process_pid)" || { rm -f "$(pid_file)"; return 0; }
	kill -TERM "$pid"
	for _ in $(seq 1 90); do
		kill -0 "$pid" 2>/dev/null || { rm -f "$(pid_file)"; return 0; }
		sleep 1
	done
	echo "elsebot: the API did not stop within 90 s; killing it" >&2
	kill -KILL "$pid" 2>/dev/null || true
	rm -f "$(pid_file)"
}

is_active() {
	case "$ELSEBOT_MANAGER" in
	systemd) systemctl --user is-active --quiet "$ELSEBOT_SERVICE.service" ;;
	launchd) [ -n "$(launchd_pid)" ] ;;
	*) process_pid >/dev/null ;;
	esac
}

reset_installation() {
	case "${1:-}" in
	-h | --help)
		echo "Usage: elsebot reset [--yes]"
		echo "Quit the desktop app first. Reset permanently deletes this installation's local"
		echo "history, memory, credentials, projects, bot computers, backups, logs and app connection."
		echo "Installed software, host settings and provider CLI logins are kept. Remote servers"
		echo "and remote backups are not changed. The local server stays stopped after reset."
		return ;;
	esac
	[ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = --yes ]; } || die "usage: elsebot reset [--yes]"
	need_api
	echo "Reset $ELSE_HOME?"
	echo "This permanently deletes local history, memory, credentials, projects, bot computers,"
	echo "backups, logs and the saved app connection. Quit the desktop app before continuing."
	if [ "${1:-}" != --yes ]; then
		[ -t 0 ] || die "reset needs confirmation in a terminal; use --yes for non-interactive reset"
		local answer
		read -r -p "Type reset to continue: " answer || return 1
		[ "$answer" = reset ] || { echo "Reset cancelled."; return 0; }
	fi
	local command processes
	processes="$(ps -axww -o command=)" || die "could not check whether the desktop app is running"
	while IFS= read -r command; do
		case "$command" in
		*"$CURRENT/bin/else-desktop"* | *"$ELSE_HOME/versions/"*"/bin/else-desktop"*)
			die "quit this installation's desktop app before resetting" ;;
		esac
		if [ -n "$ELSEBOT_APP" ] && [[ "$command" == *"$ELSEBOT_APP/Contents/MacOS/else-desktop"* ]]; then
			die "quit this installation's desktop app before resetting"
		fi
	done <<<"$processes"
	stop || die "could not stop the API; nothing was deleted"
	(cd "$CONFIG" && ELSE_HOME="$ELSE_HOME" "$CURRENT/bin/else-api" reset --yes)
}


macos_app_bundles() {
	python3 - "$ELSEBOT_APP" "$ELSE_HOME" "$1" <<'PYTHON'
import json
from pathlib import Path
import re
import shutil
import sys

app, home = map(Path, sys.argv[1:3])
home = home.resolve()

def owned(bundle):
    if bundle.is_symlink():
        return False
    try:
        marker = json.loads((bundle / "Contents/Resources/installation.json").read_text())
        return Path(marker["home"]).is_absolute() and Path(marker["home"]).resolve() == home
    except (OSError, ValueError, KeyError, TypeError):
        return False

if (app.exists() or app.is_symlink()) and not owned(app):
    sys.exit(f"{app} does not belong to this installation")
bundles = [app] if app.exists() else []
for candidate in app.parent.glob(f".{app.name}.*"):
    if re.fullmatch(rf"\.{re.escape(app.name)}\.[0-9a-f]{{32}}\.(old|new)", candidate.name) and owned(candidate):
        bundles.append(candidate)
if sys.argv[3] == "remove":
    for bundle in bundles:
        shutil.rmtree(bundle)
    (app.parent / f".{app.name}.lock").unlink(missing_ok=True)
else:
    for bundle in bundles:
        print(bundle)
PYTHON
}

owned_desktop() {
	local process_home="$2" app_bundles="$3" executable bundle
	for executable in "$1" "$(cd "${1%/*}" 2>/dev/null && pwd -P)/${1##*/}"; do
		case "$executable" in
		"$ELSE_HOME/"*/bin/else-desktop | "$ELSE_HOME/"*/Contents/MacOS/else-desktop | \
		"$process_home/"*/bin/else-desktop | "$process_home/"*/Contents/MacOS/else-desktop) return 0 ;;
		esac
		while IFS= read -r bundle; do
			[ -n "$bundle" ] && [ "$executable" = "$bundle/Contents/MacOS/else-desktop" ] && return 0
		done <<<"$app_bundles"
	done
	return 1
}

remove_desktop() {
	local pid executable processes process_home="$1" app_bundles="$2"
	processes="$(ps -axww -o pid= -o comm=)" || die "could not list desktop processes"
	while read -r pid executable; do
		[ -n "$pid" ] || continue
		if [ -d /proc ]; then
			executable="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
			executable="${executable% (deleted)}"
		fi
		owned_desktop "$executable" "$process_home" "$app_bundles" || continue
		kill -TERM "$pid" 2>/dev/null || die "could not stop desktop process $pid; close it and retry removal"
		local attempt
		for attempt in $(seq 1 10); do
			kill -0 "$pid" 2>/dev/null || break
			sleep 1
		done
		if kill -0 "$pid" 2>/dev/null; then
			die "desktop process $pid did not quit; close it and retry removal"
		fi
	done <<<"$processes"
}

remove_installation() {
	case "${1:-}" in
	-h | --help)
		echo "Usage: elsebot remove [--yes]"
		echo "Uninstall this machine's app and server, including services, local history, memory,"
		echo "credentials, bot projects, computers, backups, logs, installed releases and tools."
		echo "The app and server are stopped first. Remote servers, remote backups, shared system"
		echo "packages and your provider CLI logins are kept. Custom external storage is refused."
		return ;;
	esac
	[ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = --yes ]; } || die "usage: elsebot remove [--yes]"
	local removal_root original_home="$ELSE_HOME" user_home
	case "$ELSE_HOME" in /*) ;; *) die "removal requires an absolute ELSE_HOME" ;; esac
	[ -d "$ELSE_HOME" ] || { echo "else.bot is already removed from $ELSE_HOME."; return; }
	removal_root="$(cd "$ELSE_HOME" && pwd -P)"
	user_home="$(cd "$HOME" && pwd -P)"
	case "$user_home/" in "$removal_root/"*) die "refusing to remove HOME or one of its parents" ;; esac
	[ "$removal_root" != / ] || die "refusing to remove /"
	[ "$self" -ef "$ELSE_HOME/bin/elsebot" ] || die "run this installation's $ELSE_HOME/bin/elsebot remove"
	[ ! -L "$RUN" ] && [ ! -L "$CONFIG" ] || die "removal refuses symlinked run or config directories"
	local unit plist desktop icon link app_bundles="" unit_owned=0 plist_owned=0
	unit="$(unit_file)"
	plist="$(login_plist)"
	desktop="$HOME/.local/share/applications/else-bot.desktop"
	icon="$HOME/.local/share/icons/hicolor/scalable/apps/else-bot.svg"
	link="$HOME/.local/bin/elsebot"
	if [ -e "$unit" ]; then
		if grep -Fxq "WorkingDirectory=$CONFIG" "$unit"; then
			unit_owned=1
		elif [ "$ELSEBOT_MANAGER" = systemd ]; then
			die "$unit belongs to another installation"
		fi
	fi
	if [ -e "$plist" ]; then
		if grep -Fq "<string>$(xml "$CONFIG")</string>" "$plist"; then
			plist_owned=1
		elif [ "$ELSEBOT_MANAGER" = launchd ]; then
			die "$plist belongs to another installation"
		fi
	fi
	if [ -n "$ELSEBOT_APP" ]; then
		app_bundles="$(macos_app_bundles list)" || die "could not check app bundle ownership"
	fi
	echo "Remove else.bot from $ELSE_HOME?"
	echo "This permanently deletes the app, server, local history, credentials, bot projects,"
	echo "computers and backups, along with all installed else.bot software and settings."
	if [ "${1:-}" != --yes ]; then
		[ -t 0 ] || die "remove needs confirmation in a terminal; use --yes for non-interactive removal"
		local answer
		read -r -p "Type remove to continue: " answer || return 1
		[ "$answer" = remove ] || { echo "Removal cancelled."; return 0; }
	fi
	mkdir -p "$RUN"
	mkdir "$RUN/install.lock" 2>/dev/null || die "another installer or removal holds $RUN/install.lock"
	printf '%s\n' "$$" >"$RUN/install.lock/pid"
	trap 'rm -rf "$RUN/install.lock"' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	remove_desktop "$removal_root" "$app_bundles"
	case "$ELSEBOT_MANAGER" in
	systemd)
		local loaded
		loaded="$(systemctl --user show -p LoadState --value "$ELSEBOT_SERVICE.service")" || die "could not inspect the API service"
		if [ "$loaded" != not-found ]; then
			local working_directory
			working_directory="$(systemctl --user show -p WorkingDirectory --value "$ELSEBOT_SERVICE.service")" ||
				die "could not inspect the API service directory"
			[ "$working_directory" = "$CONFIG" ] || die "the loaded API service belongs to another installation"
			stop || die "could not stop the API service"
			if [ -e "$unit" ]; then
				systemctl --user disable "$ELSEBOT_SERVICE.service" || die "could not disable the API service"
			fi
		fi ;;
	launchd)
		if launchd_loaded; then
			launchctl print "$(launchd_domain)/$LABEL" | sed 's/^[[:space:]]*//' | grep -Fxq "working directory = $CONFIG" ||
				die "the loaded API agent belongs to another installation"
		fi
		stop || die "could not stop the API agent"
		if launchd_loaded; then die "could not unload the API agent"; fi ;;
	process) stop || die "could not stop the API" ;;
	*) die "unknown service manager: $ELSEBOT_MANAGER" ;;
	esac
	if [ -f "$CONFIG/.env" ] || [ -d "$ELSE_HOME/data" ]; then
		[ -x "$SERVER_CURRENT/bin/else-api" ] || die "restore the server binary before removing its data"
		local cleanup_command=reset
		if (cd "$CONFIG" && "$SERVER_CURRENT/bin/else-api" --help) | grep -Fq 'remove-state --yes'; then cleanup_command=remove-state; fi
		(cd "$CONFIG" && ELSE_HOME="$ELSE_HOME" "$SERVER_CURRENT/bin/else-api" "$cleanup_command" --yes) ||
			die "could not clean up local state; restore the server with elsebot update and retry removal"
		if [ "$cleanup_command" = reset ] && [ "$(cat "$RUN/install.lock/pid" 2>/dev/null || true)" != "$$" ]; then
			trap - EXIT
			mkdir "$RUN/install.lock" 2>/dev/null || die "another installer started during cleanup; retry removal after it finishes"
			printf '%s\n' "$$" >"$RUN/install.lock/pid"
			trap 'rm -rf "$RUN/install.lock"' EXIT
		fi
	fi
	if [ "$unit_owned" = 1 ]; then
		rm -f "$unit"
		systemctl --user daemon-reload || die "could not reload user services"
		systemctl --user reset-failed "$ELSEBOT_SERVICE.service" >/dev/null 2>&1 || true
	fi
	if [ "$plist_owned" = 1 ]; then rm -f "$plist"; fi
	if [ -f "$desktop" ] && grep -Fxq "Exec=$ELSE_HOME/bin/elsebot desktop" "$desktop"; then
		rm -f "$desktop" "$icon"
		if command -v update-desktop-database >/dev/null 2>&1; then
			update-desktop-database "$(dirname "$desktop")" >/dev/null 2>&1 || true
		fi
	fi
	if [ -L "$link" ] && [ "$link" -ef "$ELSE_HOME/bin/elsebot" ]; then rm -f "$link"; fi
	if [ -n "$ELSEBOT_APP" ]; then macos_app_bundles remove; fi
	cd /
	rm -rf "$removal_root"
	if [ -L "$original_home" ]; then rm -f "$original_home"; fi
	echo "else.bot removed."
}


cmd="${1:-status}"
[ $# -gt 0 ] && shift
case "$cmd" in
status)
	echo "server:    $(installed else-api || echo none) ($ELSE_HOME)"
	echo "app:       $(installed else-desktop || echo none)"
	if [ ! -x "$SERVER_CURRENT/bin/else-api" ]; then
		echo "API:       not on this machine (the app connects to a server elsewhere)"
	elif is_active; then
		echo "API:       running on http://$(api_addr), version $(running_version || echo unknown) ($ELSEBOT_MANAGER)"
	else
		echo "API:       stopped ($ELSEBOT_MANAGER)"
	fi
	if [ "$ELSEBOT_AUTOSTART" = 1 ]; then
		echo "autostart: on (change with: elsebot update --no-autostart)"
	else
		echo "autostart: off (change with: elsebot update --autostart)"
	fi
	;;
version) installed else-api || installed else-desktop || die "not installed" ;;
update)
	[ -f "$ELSE_HOME/src/install.sh" ] || die "no source in $ELSE_HOME/src; run the curl installer again"
	tmp="$(mktemp)"
	trap 'rm -f "$tmp"' EXIT
	cp "$ELSE_HOME/src/install.sh" "$tmp"
	ELSE_HOME="$ELSE_HOME" bash "$tmp" "$@"
	;;
update-background)
	[ "$#" = 2 ] || die "update-background requires a request ID and version"
	request_id="$1"
	case "$request_id" in *[!0-9a-f-]* | "") die "invalid update request ID" ;; esac
	job="$RUN/server-updates/$request_id"
	[ -f "$job/worker.sh" ] || die "no prepared background update"
	case "$ELSEBOT_MANAGER" in
	systemd)
		systemd-run --user --quiet --collect --unit="else-update-$request_id" --property=Type=exec \
			-- /bin/bash "$job/worker.sh" "$ELSE_HOME" "$2" "$job"
		;;
	launchd)
		launchctl submit -l "bot.else.update.$request_id" -- /bin/bash "$job/worker.sh" "$ELSE_HOME" "$2" "$job"
		;;
	process)
		if command -v setsid >/dev/null 2>&1; then
			nohup setsid /bin/bash "$job/worker.sh" "$ELSE_HOME" "$2" "$job" >/dev/null 2>&1 </dev/null &
		else
			nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!"' \
				/bin/bash "$job/worker.sh" "$ELSE_HOME" "$2" "$job" >/dev/null 2>&1 </dev/null &
		fi
		;;
	*) die "unsupported service manager" ;;
	esac
	;;
desktop)
	[ -x "$APP_CURRENT/bin/else-desktop" ] || die "the app is not installed; add it with: elsebot update --app-only"
	case "${1:-}" in version | --version | -V) exec "$APP_CURRENT/bin/else-desktop" "$@" ;; esac
	cd /
	unset ELSE_DESKTOP_CONFIG_FILE ELSE_API_URL ELSE_OWNER_TOKEN ELSE_OWNER_TOKEN_FILE OWNER_TOKEN_FILE ELSE_DATA_DIR
	if [ "$(uname -s)" = Darwin ]; then
		[ -n "$ELSEBOT_APP" ] && [ -d "$ELSEBOT_APP" ] ||
			die "the app is missing${ELSEBOT_APP:+ at $ELSEBOT_APP}; publish it again with: elsebot update"
		if [ $# -gt 0 ]; then exec open -a "$ELSEBOT_APP" --args "$@"; fi
		exec open -a "$ELSEBOT_APP"
	fi
	ELSE_HOME="$ELSE_HOME" exec "$APP_CURRENT/bin/else-desktop" "$@"
	;;
start) start ;;
stop) stop ;;
restart) stop && start ;;
reset) reset_installation "$@" ;;
remove) remove_installation "$@" ;;
service-install) service_install ;;
logs)
	if [ "$ELSEBOT_MANAGER" = systemd ]; then
		exec journalctl --user -u "$ELSEBOT_SERVICE.service" -f "$@"
	else
		exec tail -n 100 -f "$LOGS/else-api.log"
	fi
	;;
api)
	need_api
	cd "$CONFIG" && exec "$SERVER_CURRENT/bin/else-api" "$@"
	;;
db)
    command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is not installed (needed only for SQL inspection)"
    url="$(setting DATABASE_URL)"
    [ -n "$url" ] || url="sqlite://$(setting ELSE_DATA_DIR)/else.sqlite3"
    case "$url" in
        sqlite://*) path="${url#sqlite://}" ;;
        sqlite:*) path="${url#sqlite:}" ;;
        *) die "DATABASE_URL must be a SQLite URL" ;;
    esac
    path="${path%%\?*}"
    cd "$CONFIG"
    exec sqlite3 -readonly "$path" "$@"
    ;;
paths)
	where="$(pid_file)"
	[ "$ELSEBOT_MANAGER" = systemd ] && where="$(unit_file)"
	[ "$ELSEBOT_MANAGER" = launchd ] && where="$(plist_file)"
	cat <<EOF
home:        $ELSE_HOME
source:      $ELSE_HOME/src
server:      $(readlink "$SERVER_CURRENT" 2>/dev/null || echo none)
app release: $(readlink "$APP_CURRENT" 2>/dev/null || echo none)
settings:    $CONFIG/.env
app server:  $CONFIG/desktop.json
${ELSEBOT_APP:+app:         $ELSEBOT_APP
}data:        $ELSE_HOME/data
logs:        $LOGS
service:     $ELSEBOT_MANAGER ($where)
EOF
	;;
-h | --help | help) usage ;;
*) usage >&2; exit 2 ;;
esac
